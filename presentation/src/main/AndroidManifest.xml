<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permite descobrir um app de câmera no Android 11+ (visibilidade de pacotes). -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application>

        <!--
            FileProvider usado para entregar à câmera um URI gravável de um arquivo temporário no
            cache do app (ver SkyPlotScreen.createCaptureUri). A autoridade usa o placeholder
            ${applicationId} para funcionar nos dois flavors (develop/production).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/presentation_file_paths" />
        </provider>

    </application>

</manifest>
